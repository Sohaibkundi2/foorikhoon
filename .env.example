# Database
DATABASE_URL=set-your-postgres-database-url-here

# Backend server
PORT=5000
JWT_SECRET=set-your-jwt-secret-here

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name-here
CLOUDINARY_API_KEY=your-cloudinary-api-key-here
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-here

# Frontend — must be reachable from the BROWSER, not just the server.
# Use your EC2 public IP or domain when deploying, not localhost.
NEXT_PUBLIC_API_URL=http://localhost:5000

# AI Engine — internal service URL (server-to-server, not browser-facing)
AI_ENGINE_URL=http://localhost:5001