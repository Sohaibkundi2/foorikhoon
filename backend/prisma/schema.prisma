generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  phone     String?
  role      Role      @default(DONOR)
  password  String
  city      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  donor     Donor?
  hospital  Hospital?
}

model Donor {
  id              String     @id @default(uuid())
  userId          String     @unique
  bloodGroup      BloodGroup
  lastDonated     DateTime?
  isAvailable     Boolean    @default(true)
  commitmentScore Int        @default(0)
  area            String
  latitude        Float
  longitude       Float
  user            User       @relation(fields: [userId], references: [id])
  matches         Match[]
  pushToken       String?
}

model Hospital {
  id        String         @id @default(uuid())
  userId    String         @unique
  name      String
  address   String
  latitude  Float
  longitude Float
  licenseNo String         @unique
  verified  Boolean        @default(false)
  requests  BloodRequest[]
  user      User           @relation(fields: [userId], references: [id])
  inventory Inventory[]
}

model BloodRequest {
  id         String        @id @default(uuid())
  hospitalId String
  bloodGroup BloodGroup
  units      Int
  urgency    Urgency       @default(NORMAL)
  status     RequestStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  expiresAt  DateTime?
  hospital   Hospital      @relation(fields: [hospitalId], references: [id])
  matches    Match[]
}

model Match {
  id          String       @id @default(uuid())
  requestId   String
  donorId     String
  status      MatchStatus  @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime     @default(now())
  donor       Donor        @relation(fields: [donorId], references: [id])
  request     BloodRequest @relation(fields: [requestId], references: [id])
}

model Inventory {
  id         String     @id @default(uuid())
  hospitalId String
  bloodGroup BloodGroup
  units      Int        @default(0)
  updatedAt  DateTime   @updatedAt
  hospital   Hospital   @relation(fields: [hospitalId], references: [id])

  @@unique([hospitalId, bloodGroup])
}

enum Role {
  DONOR
  HOSPITAL
  ADMIN
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum Urgency {
  NORMAL
  URGENT
  CRITICAL
}

enum RequestStatus {
  PENDING
  MATCHED
  FULFILLED
  EXPIRED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}
