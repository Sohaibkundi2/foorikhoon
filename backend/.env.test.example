# Copy this file to `.env.test` and fill in DATABASE_URL.
#
# DATABASE_URL **must** point at a dedicated test database — a Neon branch or a separate
# Neon project. The integration tests create and delete rows. `tests/setup/loadTestEnv.ts`
# aborts the run if this value resolves to the same database as the one in `.env`.
#
# Getting a Neon branch:
#   Neon console -> your project -> Branches -> New branch (e.g. "test")
#   -> Connect -> copy the connection string
#
# Then apply the schema to it once:
#   npm run test:migrate

DATABASE_URL='postgresql://USER:....'

# Only needs to be internally consistent — the tests sign their own tokens.
# Leave unset and the suite falls back to a built-in test secret.
JWT_SECRET='foorikhoon-test-jwt-secret'

# Placeholders. Cloudinary uploads are mocked in tests; these exist only so the SDK's
# "not configured" check passes on read paths. No requests are made to Cloudinary.
CLOUDINARY_CLOUD_NAME='test-cloud'
CLOUDINARY_API_KEY='test-key'
CLOUDINARY_API_SECRET='test-secret'
